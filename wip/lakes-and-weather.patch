+
+// ------------------------------------------------------------------ geometry
+
+function linear(hex: number): [number, number, number] {
+  const c = new THREE.Color().setHex(hex, THREE.SRGBColorSpace);
+  return [c.r, c.g, c.b];
+}
+
+/** One sheet per lake, merged. Null when the world has no lakes. */
+function buildGeometry(list: readonly Lake[]): THREE.BufferGeometry | null {
+  if (list.length === 0) return null;
+  const pos: number[] = [];
+  const shore: number[] = [];
+  const lake: number[] = [];
+  const lake2: number[] = [];
+  const sky0: number[] = [];
+  const sky1: number[] = [];
+  const deep: number[] = [];
+  const shallow: number[] = [];
+  const edge: number[] = [];
+  const index: number[] = [];
+
+  for (const l of list) {
+    const extent = Math.max(l.maxX - l.minX, l.maxZ - l.minZ);
+    const cell = Math.min(28, Math.max(4, extent / MAX_CELLS));
+    const margin = SKIRT + cell;
+    const x0 = l.minX - margin;
+    const z0 = l.minZ - margin;
+    const nx = Math.ceil((l.maxX - l.minX + margin * 2) / cell);
+    const nz = Math.ceil((l.maxZ - l.minZ + margin * 2) / cell);
+    const cols = nx + 1;
+    const s = new Float32Array(cols * (nz + 1));
+    for (let j = 0; j <= nz; j++) {
+      for (let i = 0; i <= nx; i++) s[j * cols + i] = lakeSignedDistance(l, x0 + i * cell, z0 + j * cell);
+    }
+    const p = PALETTE[l.kind];
+    const cd = linear(p.deep);
+    const cs = linear(p.shallow);
+    const ce = linear(p.edge);
+    const seed = l.seed % 97;
+    const ids = new Int32Array(cols * (nz + 1)).fill(-1);
+    const vertex = (i: number, j: number): number => {
+      const k = j * cols + i;
+      if (ids[k] >= 0) return ids[k];
+      const id = pos.length / 3;
+      ids[k] = id;
+      pos.push(x0 + i * cell, l.level, z0 + j * cell);
+      shore.push(-s[k]);
+      lake.push(KIND_CODE[l.kind], l.looks, l.freeze, l.surround);
+      lake2.push(l.width, seed);
+      sky0.push(l.skyline[0], l.skyline[1], l.skyline[2], l.skyline[3]);
+      sky1.push(l.skyline[4], l.skyline[5], l.skyline[6], l.skyline[7]);
+      deep.push(...cd);
+      shallow.push(...cs);
+      edge.push(...ce);
+      return id;
+    };
+    for (let j = 0; j < nz; j++) {
+      for (let i = 0; i < nx; i++) {
+        const a = j * cols + i;
+        const lo = Math.min(s[a], s[a + 1], s[a + cols], s[a + cols + 1]);
+        if (lo > margin - cell * 0.5) continue;
+        const v00 = vertex(i, j);
+        const v10 = vertex(i + 1, j);
+        const v01 = vertex(i, j + 1);
+        const v11 = vertex(i + 1, j + 1);
+        // Counter-clockwise seen from above.
+        index.push(v00, v01, v10, v10, v01, v11);
+      }
+    }
+  }
+  if (index.length === 0) return null;
+
+  const geo = new THREE.BufferGeometry();
+  geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
+  const count = pos.length / 3;
+  const normals = new Float32Array(count * 3);
+  for (let i = 0; i < count; i++) normals[i * 3 + 1] = 1;
+  geo.setAttribute('normal', new THREE.BufferAttribute(normals, 3));
+  geo.setAttribute('aShore', new THREE.Float32BufferAttribute(shore, 1));
+  geo.setAttribute('aLake', new THREE.Float32BufferAttribute(lake, 4));
+  geo.setAttribute('aLake2', new THREE.Float32BufferAttribute(lake2, 2));
+  geo.setAttribute('aSky0', new THREE.Float32BufferAttribute(sky0, 4));
+  geo.setAttribute('aSky1', new THREE.Float32BufferAttribute(sky1, 4));
+  geo.setAttribute('aDeep', new THREE.Float32BufferAttribute(deep, 3));
+  geo.setAttribute('aShallow', new THREE.Float32BufferAttribute(shallow, 3));
+  geo.setAttribute('aEdge', new THREE.Float32BufferAttribute(edge, 3));
+  geo.setIndex(count > 65535 ? new THREE.Uint32BufferAttribute(index, 1) : new THREE.Uint16BufferAttribute(index, 1));
