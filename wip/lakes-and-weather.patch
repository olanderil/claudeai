new file mode 100644
index 0000000..7e8d3a8
--- /dev/null
+++ b/src/world/WeatherSky.ts
@@ -0,0 +1,128 @@
+import * as THREE from 'three';
+
+/**
+ * The sky's own colour under weather.
+ *
+ * The sky model is Preetham, which is a clear sky and nothing else: however
+ * far its turbidity is pushed it stays a blue dome with a sun disc in it. Under
+ * an overcast that is wrong in exactly the places the cloud does not cover —
+ * the breaks in the deck and the band along the horizon — and it is wrong in
+ * the reflections too, since the aircraft and the sea are lit by a bake of
+ * that same blue sky. So a dome sits just inside the sky and paints it the
+ * colour weather makes it: pale grey at the horizon, the darker grey of the
+ * cloud overhead, a soft bright patch where the sun is behind thin cloud and
+ * nothing at all where it is behind thick.
+ *
+ * At full strength it is opaque and the Preetham sky is gone, sun disc and
+ * all — which matters, because the disc is four orders of magnitude over the
+ * bloom threshold and ten per cent of it leaking through a translucent grey is
+ * still a blinding spot in a sky that should have none.
+ *
+ * A second, tiny copy of the dome goes into the environment bake so that
+ * reflections come from the same grey sky.
+ */
+const RADIUS = 104000;
+
+export class WeatherSky {
+  readonly dome: THREE.Mesh;
+  /** The same dome at a size the environment bake's cube camera can see. */
+  readonly bakeDome: THREE.Mesh;
+  private readonly material: THREE.ShaderMaterial;
+  private amount = 0;
+
+  constructor() {
+    this.material = new THREE.ShaderMaterial({
+      uniforms: {
+        uAmount: { value: 0 },
+        uZenith: { value: new THREE.Color(0.4, 0.42, 0.45) },
+        uHorizon: { value: new THREE.Color(0.6, 0.62, 0.65) },
+        uSunDir: { value: new THREE.Vector3(0, 1, 0) },
+        uSunGlow: { value: new THREE.Color(0, 0, 0) },
+      },
+      vertexShader: /* glsl */ `
+        #include <common>
+        #include <logdepthbuf_pars_vertex>
+        varying vec3 vDir;
+        void main() {
+          vDir = normalize(position);
+          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
+          #include <logdepthbuf_vertex>
+        }
+      `,
+      fragmentShader: /* glsl */ `
+        #include <common>
+        #include <logdepthbuf_pars_fragment>
+        uniform float uAmount;
+        uniform vec3 uZenith;
+        uniform vec3 uHorizon;
+        uniform vec3 uSunDir;
+        uniform vec3 uSunGlow;
+        varying vec3 vDir;
+        void main() {
+          #include <logdepthbuf_fragment>
+          vec3 dir = normalize(vDir);
+          float up = clamp(dir.y, -0.2, 1.0);
+          // Brightest in a band just over the horizon — the light coming in
+          // under the edge of the overcast from far away — and darkening
+          // overhead, where you are looking up at the thickest of it.
+          vec3 col = mix(uHorizon, uZenith, smoothstep(0.0, 0.55, up));
+          col = mix(col, uHorizon * 0.9, smoothstep(0.0, -0.2, up));
+          // The sun behind the cloud: a broad soft brightening, no disc.
+          float toward = max(dot(dir, uSunDir), 0.0);
+          col += uSunGlow * (pow(toward, 12.0) * 0.8 + pow(toward, 3.0) * 0.25);
+          // Opaque once the weather is heavy, and a little thinner at the
+          // horizon than overhead until then, so a light haze still lets the
+          // sky's own sunset colour through at the bottom.
+          float a = clamp(uAmount * mix(0.8, 1.15, smoothstep(0.0, 0.4, up)), 0.0, 1.0);
+          a = mix(a, 1.0, smoothstep(0.97, 1.0, uAmount));
+          gl_FragColor = vec4(col, a);
+        }
+      `,
+      transparent: true,
+      depthWrite: false,
+      side: THREE.BackSide,
+      fog: false,
+    });
+
+    this.dome = new THREE.Mesh(new THREE.SphereGeometry(RADIUS, 32, 16), this.material);
+    this.dome.frustumCulled = false;
+    // After the Preetham sky, before the twilight cast and the stars.
+    this.dome.renderOrder = -3;
+    this.dome.visible = false;
+
+    this.bakeDome = new THREE.Mesh(new THREE.SphereGeometry(50, 24, 12), this.material);
+    this.bakeDome.frustumCulled = false;
+    this.bakeDome.visible = false;
+  }
+
+  /**
+   * How much the weather owns the sky (0 clear, 1 an opaque overcast), the
+   * two ends of its gradient, and the sun's glow through it.
+   */
+  set(amount: number, zenith: THREE.Color, horizon: THREE.Color, sunDir: THREE.Vector3, sunGlow: THREE.Color): void {
+    this.amount = amount;
+    const u = this.material.uniforms;
+    u.uAmount.value = amount;
+    u.uZenith.value.copy(zenith);
+    u.uHorizon.value.copy(horizon);
+    u.uSunDir.value.copy(sunDir).normalize();
+    u.uSunGlow.value.copy(sunGlow);
+    this.dome.visible = amount > 0.004;
+    this.bakeDome.visible = this.dome.visible;
+  }
+
+  /** How much there is, so the bake knows when it has changed. */
+  get strength(): number {
+    return this.amount;
+  }
+
+  follow(focus: THREE.Vector3): void {
+    this.dome.position.copy(focus);
+  }
+
+  dispose(): void {
+    this.dome.geometry.dispose();
+    this.bakeDome.geometry.dispose();
+    this.material.dispose();
+  }
+}
