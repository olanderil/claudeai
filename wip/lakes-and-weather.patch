+import { noise2 } from '../util/noise';
+import { clamp, lerp, smoothstep } from '../util/math';
+
+/**
+ * Lakes: glacial lakes and tarns, meres, étangs, karst ponds, salt pans, oases.
+ *
+ * A lake here is two things that have to agree. On the ground it is a basin
+ * cut into the height field below a flat water level, with a bank that stands
+ * clear of the water all the way round; in the scene it is a flat sheet at
+ * that level, drawn a little past the shore so the bank hides its edge. The
+ * shoreline the eye sees is therefore the contour where the terrain crosses
+ * the water, which is the same line `isWater` answers for — the sea works the
+ * same way, one plane and ground that dips under it.
+ *
+ * Planned once per world and seed like the rivers and the villages: the world
+ * proposes candidates (a valley floor, a cirque, the Somme's marshes), and
+ * the planner here keeps the ones that fit — level ground round the rim, clear
+ * of the aerodromes, the lines, the rivers and each other — and sets each
+ * one's water level just under the lowest point of its rim. Per sample it is
+ * one hash-grid lookup that misses almost everywhere.
+ *
+ * Pure numbers, no three.js: the planners, the checks and the renderer all
+ * read the same list.
+ */
+
+export type LakeKind =
+  /** A long lake on a glacial valley floor: deep, milky green-blue. */
+  | 'glacial'
+  /** A small high lake in a cirque. */
+  | 'tarn'
+  /** A green mountain lake under forest and pale walls (Braies, Misurina). */
+  | 'alpine'
+  /** A pond in a karst doline, or a seasonal polje lake. */
+  | 'karst'
+  /** A shallow reedy mere on low ground. */
+  | 'mere'
+  /** Flooded low meadow: a sheet of water with the grass standing through it. */
+  | 'flood'
+  /** A marsh pond on a river's floor (the Somme's étangs). */
+  | 'etang'
+  /** A salt lake: crust and a skin of brine. */
+  | 'salt'
+  /** A sabkha: a salt flat, damp mud and crust, water only after rain. */
+  | 'sabkha'
+  /** A desert pool among palms. */
+  | 'oasis';
+
+/** What the ground at the water's edge is made of. Mirrored in the terrain shader. */
+export const SHORE_PEBBLE = 0;
+export const SHORE_REEDS = 1;
+export const SHORE_SAND = 2;
+export const SHORE_SALT = 3;
+export const SHORE_MUD = 4;
+
+/** Per-kind defaults: how the basin is cut and what its shore is. */
+const KINDS: Record<LakeKind, {
+  shore: number;
+  /** Deepest cut below the water, metres. Kept modest: nobody sees the bed. */
+  depth: number;
+  /** Width of the shelving margin, as a share of the lake's half-width. */
+  shelf: number;
+  /** How ragged the shoreline is, as a share of the half-width. */
+  wobble: number;
+  /** How readily it freezes in winter, 0..1. */
+  freeze: number;
+  /** Depth the colour ramp reads, metres (the carve is shallower). */
+  looks: number;
+}> = {
+  glacial: { shore: SHORE_PEBBLE, depth: 9, shelf: 0.22, wobble: 0.16, freeze: 0.9, looks: 70 },
+  tarn: { shore: SHORE_PEBBLE, depth: 6, shelf: 0.35, wobble: 0.2, freeze: 1, looks: 18 },
+  alpine: { shore: SHORE_PEBBLE, depth: 7, shelf: 0.3, wobble: 0.2, freeze: 1, looks: 22 },
+  karst: { shore: SHORE_MUD, depth: 3, shelf: 0.45, wobble: 0.22, freeze: 0.35, looks: 5 },
+  mere: { shore: SHORE_REEDS, depth: 3, shelf: 0.4, wobble: 0.3, freeze: 0.8, looks: 5 },
+  flood: { shore: SHORE_MUD, depth: 1.8, shelf: 0.5, wobble: 0.34, freeze: 0.9, looks: 1.6 },
+  etang: { shore: SHORE_REEDS, depth: 3, shelf: 0.4, wobble: 0.32, freeze: 0.85, looks: 4 },
+  salt: { shore: SHORE_SALT, depth: 1.5, shelf: 0.5, wobble: 0.2, freeze: 0, looks: 1.2 },
+  sabkha: { shore: SHORE_SAND, depth: 1.2, shelf: 0.5, wobble: 0.3, freeze: 0, looks: 0.55 },
+  oasis: { shore: SHORE_MUD, depth: 3, shelf: 0.5, wobble: 0.14, freeze: 0, looks: 6 },
+};
+
+export interface Lake {
+  kind: LakeKind;
+  /** `SHORE_*`. */
+  shore: number;
+  /** The spine: one node is a round lake, several a long or bent one. */
+  pts: { x: number; z: number; w: number }[];
+  /** Water surface, metres. */
+  level: number;
+  /** Deepest cut below the water, metres. */
+  depth: number;
+  /** Distance in from the shore over which the bed shelves to full depth, metres. */
+  shelf: number;
+  /** Shoreline wobble, metres, and its frequency, 1/m. */
+  wobble: number;
+  wobFreq: number;
+  seed: number;
+  freeze: number;
+  /** Depth the renderer's colour ramp reads, metres. */
+  looks: number;
+  /** Widest half-width, metres. */
+  width: number;
+  /** Extent of the water (not the bank). */
+  minX: number;
+  maxX: number;
+  minZ: number;
+  maxZ: number;
+  /**
+   * How high the country stands round the lake, as elevation angles in
+   * radians for eight bearings (north, then clockwise). The water reflects
+   * these slopes rather than sky below them.
+   */
+  skyline: number[];
+  /** Brightness of that surrounding country in the reflection, 0..1. */
+  surround: number;
+}
+
+/** What a world proposes. The planner decides the level and whether it fits. */
+export interface LakeCandidate {
+  kind: LakeKind;
+  /** Spine nodes: x, z, half-width. */
+  pts: [number, number, number][];
+  /** Largest rise round the rim the site may have, metres. */
+  maxSpread?: number;
+  /** Water this far under the lowest point of the rim, metres. */
+  freeboard?: number;
+  /** Overrides the kind's shoreline raggedness (share of the half-width). */
+  wobble?: number;
+  /**
+   * A fixed water level, for a lake a river runs into: it has to sit at the
+   * river's own level, not wherever its rim would put it.
+   */
+  level?: number;
+  /** Fed by a river, so the river's channel does not count against the site. */
+  riverFed?: boolean;
+}
+
+export interface LakeGroup {
+  /** Keep at most this many. */
+  want: number;
+  candidates: LakeCandidate[];
+}
+
+export interface LakePlanContext {
+  /** Ground as the lake finds it: natural relief with the rivers cut in. */
+  ground: (x: number, z: number) => number;
+  /** Sea, river or canal at or near a point, given the ground there (rivers aside if `riverFed`). */
+  wet: (x: number, z: number, ground: number, riverFed: boolean) => boolean;
+  /** Ground a lake must keep off: aerodromes, their approaches, the lines, houses. */
+  blocked: (x: number, z: number) => boolean;
+  /** Lowest a lake's bed may be cut (clear of the sea, whose surface shows through anything under it). */
+  minBed: number;
+  seed: number;
+}
+
+/** How far the bank stands above the water, and the bed below it, at the shoreline. */
+const STEP = 1.2;
+/** Out to here the bank is held clear of the water, metres. */
+const BANK_HOLD = 14;
+/** And by here it has blended back into the natural ground. */
+const BANK = 60;
+/**
+ * How far out the lake answers queries, metres: the terrain shades its shore
+ * and the trees keep their distance within this.
+ */
+export const LAKE_REACH = 240;
+/** Hash-grid cell for the per-sample lookup, metres. */
+const BUCKET = 512;
+/** Signed distance reported where there is no lake near. */
+export const NO_LAKE = 1e4;
+
+let lakes: Lake[] = [];
+/**
+ * Lakes by grid cell, as a flat array over the box they cover: an array
+ * index rather than a map lookup, because every height sample asks it.
+ */
+let grid: (number[] | undefined)[] = [];
+let gridX0 = 0;
+let gridZ0 = 0;
+let gridW = 0;
+let gridH = 0;
+/** Bumped on every replan, so the renderer knows to rebuild. */
+let version = 0;
+
+/** Stash from the last `carveLakes`: nearest lake and the signed distance to its shore. */
+let hereLake: Lake | null = null;
+let hereS = NO_LAKE;
+
+/** Every planned lake for the current world and seed. */
+export function allLakes(): readonly Lake[] {
+  return lakes;
+}
+
+/** Changes whenever the lakes are replanned. */
+export function lakePlanVersion(): number {
+  return version;
+}
+
+/** The lakes whose reach covers the grid cell a point is in, if any. */
+function cellAt(x: number, z: number): number[] | undefined {
+  const gx = Math.floor((x - gridX0) / BUCKET);
+  const gz = Math.floor((z - gridZ0) / BUCKET);
+  if (gx < 0 || gz < 0 || gx >= gridW || gz >= gridH) return undefined;
+  return grid[gz * gridW + gx];
+}
+
+// ------------------------------------------------------------------ geometry
+
+/** Distance to the spine, less its half-width there: negative inside. */
+function spineDistance(l: Lake, x: number, z: number): number {
+  const p = l.pts;
+  if (p.length === 1) return Math.hypot(x - p[0].x, z - p[0].z) - p[0].w;
+  let best = Infinity;
+  for (let i = 0; i < p.length - 1; i++) {
+    const a = p[i];
+    const b = p[i + 1];
+    const dx = b.x - a.x;
+    const dz = b.z - a.z;
+    const t = clamp(((x - a.x) * dx + (z - a.z) * dz) / (dx * dx + dz * dz || 1), 0, 1);
+    const d = Math.hypot(x - a.x - dx * t, z - a.z - dz * t) - (a.w + (b.w - a.w) * t);
+    if (d < best) best = d;
+  }
+  return best;
+}
+
+/**
+ * Signed distance to a lake's shore, metres: negative on the water.
+ *
+ * The spine gives the outline, two octaves of noise give it bays and points.
+ * Not an exact distance once the noise is in, but its gradient stays near one
+ * because the wobble's slope is held under a half.
+ */
+export function lakeSignedDistance(l: Lake, x: number, z: number): number {
+  const f = l.wobFreq;
+  const n = noise2(x * f + l.seed, z * f - l.seed * 0.7) * 0.72
+    + noise2(x * f * 2.9 - l.seed * 1.3, z * f * 2.9 + 5.1) * 0.28;
+  return spineDistance(l, x, z) - n * l.wobble;
+}
+
+// ------------------------------------------------------------------ sampling
+
+/**
+ * Cut the lakes into a height field.
+ *
+ * Inside the shore the bed drops a step below the water and shelves down
+ * from there; outside it the bank is held a step above the water for a few
+ * metres and then blends back into the country. The step both ways is what
+ * keeps the shoreline from lying coplanar with the water and flickering, the
+ * same reason the coast stands clear of the sea.
+ *
+ * Also stashes the nearest lake for the readers below.
+ */
+export function carveLakes(x: number, z: number, h: number): number {
+  hereLake = null;
+  hereS = NO_LAKE;
+  if (lakes.length === 0) return h;
+  const bucket = cellAt(x, z);
+  if (bucket === undefined) return h;
+  let out = h;
+  for (let i = 0; i < bucket.length; i++) {
+    const l = lakes[bucket[i]];
+    if (x < l.minX - LAKE_REACH || x > l.maxX + LAKE_REACH || z < l.minZ - LAKE_REACH || z > l.maxZ + LAKE_REACH) continue;
+    const s = lakeSignedDistance(l, x, z);
+    if (s < hereS) {
+      hereS = s;
+      hereLake = l;
+    }
+    if (s < 0) {
+      const bed = l.level - STEP - (l.depth - STEP) * smoothstep(0, l.shelf, -s);
+      if (bed < out) out = bed;
+      continue;
+    }
+    if (s < BANK) {
+      const floor = l.level + STEP + s * 0.05;
+      if (out < floor) out = lerp(out, floor, 1 - smoothstep(BANK_HOLD, BANK, s));
+    }
+    // A shore that rises from the water rather than a wall standing in it:
+    // ground high above the lake is cut back to a bank that starts gently
+    // and steepens away from the water until it meets the hillside.
+    const cap = l.level + STEP + s * 0.3 + s * s * 0.004;
+    if (out > cap) out = lerp(cap, out, smoothstep(110, 230, s));
+  }
+  return out;
+}
+
+/** Signed distance to the nearest shore at the last `carveLakes` point (`NO_LAKE` if none near). */
+export function lakeShoreHere(): number {
+  return hereS;
+}
+
+/** Whether the last `carveLakes` point is on a lake's water. */
+export function lakeWaterHere(): boolean {
+  return hereS < 0;
+}
+
+/** The water level of the nearest lake at the last point, or -Infinity. */
+export function lakeLevelHere(): number {
+  return hereLake === null ? -Infinity : hereLake.level;
+}
+
+/** The nearest lake's shore kind at the last point (`SHORE_*`), or -1. */
+export function lakeShoreKindHere(): number {
+  return hereLake === null ? -1 : hereLake.shore;
+}
+
+/**
+ * How much the last point is spoken for by a lake, 0..1: the water and a
+ * narrow margin of bank, where no tree grows and no field is drawn.
+ */
+export function lakeClearingHere(): number {
+  return hereS >= 16 ? 0 : 1 - smoothstep(3, 16, hereS);
+}
+
+/**
+ * Signed distance to the nearest lake shore at a point, metres, without
+ * touching the stash. `NO_LAKE` where none is within reach. For the planners.
+ */
+export function lakeDistance(x: number, z: number): number {
+  if (lakes.length === 0) return NO_LAKE;
+  const bucket = cellAt(x, z);
+  if (bucket === undefined) return NO_LAKE;
+  let best = NO_LAKE;
+  for (let i = 0; i < bucket.length; i++) {
+    const l = lakes[bucket[i]];
+    if (x < l.minX - LAKE_REACH || x > l.maxX + LAKE_REACH || z < l.minZ - LAKE_REACH || z > l.maxZ + LAKE_REACH) continue;
+    const s = lakeSignedDistance(l, x, z);
+    if (s < best) best = s;
+  }
+  return best;
+}
+
+/** Whether a point is within `margin` metres of any lake's water (inside counts). */
+export function nearLake(x: number, z: number, margin: number): boolean {
+  if (lakes.length === 0) return false;
+  for (let i = 0; i < lakes.length; i++) {
+    const l = lakes[i];
+    const r = margin + l.wobble;
+    if (x < l.minX - r || x > l.maxX + r || z < l.minZ - r || z > l.maxZ + r) continue;
+    if (lakeSignedDistance(l, x, z) < margin) return true;
+  }
+  return false;
+}
+
+// ------------------------------------------------------------------ planning
+
+function cellRandom(x: number, y: number, salt: number): number {
+  let h = Math.imul(x | 0, 374761393) + Math.imul(y | 0, 668265263) + Math.imul(salt | 0, 2246822519);
+  h = Math.imul(h ^ (h >>> 13), 1274126177);
+  h ^= h >>> 16;
+  return (h >>> 0) / 4294967296;
+}
+
+/** Drop every lake: a new world or seed is about to be planned. */
+export function clearLakes(): void {
+  lakes = [];
+  reindex();
+  version++;
+}
+
+/**
+ * Keep what fits of each group, in order, against the ground as it stands.
+ * May be called more than once per plan (the oases come after the villages);
+ * each call adds to what is there.
+ */
+export function planLakes(groups: LakeGroup[], ctx: LakePlanContext): Lake[] {
+  const added: Lake[] = [];
+  let serial = lakes.length;
+  for (const g of groups) {
+    let kept = 0;
+    for (const c of g.candidates) {
+      if (kept >= g.want) break;
+      const lake = fit(c, ctx, serial);
+      if (lake === null) continue;
+      lakes.push(lake);
+      added.push(lake);
+      serial++;
+      kept++;
+    }
+  }
+  reindex();
+  version++;
+  return added;
+}
+
+function makeLake(c: LakeCandidate, seed: number): Lake {
+  const k = KINDS[c.kind];
+  const pts = c.pts.map(([x, z, w]) => ({ x, z, w }));
+  let width = 0;
+  for (const p of pts) width = Math.max(width, p.w);
+  const wobble = width * (c.wobble ?? k.wobble);
+  // Bays about one and a half half-widths apart; never so tight that the
+  // outline folds back on itself.
+  const wobFreq = Math.min(1 / (width * 1.4), 0.45 / Math.max(wobble, 1));
+  let minX = Infinity; let maxX = -Infinity; let minZ = Infinity; let maxZ = -Infinity;
+  for (const p of pts) {
+    minX = Math.min(minX, p.x - p.w - wobble);
+    maxX = Math.max(maxX, p.x + p.w + wobble);
+    minZ = Math.min(minZ, p.z - p.w - wobble);
+    maxZ = Math.max(maxZ, p.z + p.w + wobble);
+  }
+  return {
+    kind: c.kind,
+    shore: k.shore,
+    pts,
+    level: 0,
+    depth: k.depth,
+    shelf: Math.max(6, width * k.shelf),
+    wobble,
+    wobFreq,
+    seed: 37.1 + cellRandom(seed, 3, 71) * 500,
+    freeze: k.freeze,
+    looks: k.looks,
+    width,
+    minX, maxX, minZ, maxZ,
+    skyline: [0, 0, 0, 0, 0, 0, 0, 0],
+    surround: 0.3,
+  };
+}
+
+/** Try one candidate: returns the finished lake, or null if the site will not take it. */
+function fit(c: LakeCandidate, ctx: LakePlanContext, serial: number): Lake | null {
+  const lake = makeLake(c, ctx.seed * 131 + serial);
+  // Room between lakes: the banks never meet.
+  for (const o of lakes) {
+    const gap = 90;
+    if (lake.minX > o.maxX + gap || lake.maxX < o.minX - gap || lake.minZ > o.maxZ + gap || lake.maxZ < o.minZ - gap) continue;
+    // Boxes overlap: check properly along the new one's spine.
+    for (const p of lake.pts) {
+      if (lakeSignedDistance(o, p.x, p.z) < p.w + gap) return null;
+    }
+  }
+  // Survey the site: the rim for the level, and everything near for what is
+  // in the way. Fine enough that the smallest pond has a dozen rim samples.
+  const step = clamp(lake.width / 3, 7, 70);
+  const pad = 50;
+  let rimLo = Infinity;
+  let rimHi = -Infinity;
+  let inside = 0;
+  for (let z = lake.minZ - pad; z <= lake.maxZ + pad; z += step) {
+    for (let x = lake.minX - pad; x <= lake.maxX + pad; x += step) {
+      const s = lakeSignedDistance(lake, x, z);
+      if (s > pad) continue;
+      if (ctx.blocked(x, z)) return null;
+      const h = ctx.ground(x, z);
+      if (ctx.wet(x, z, h, c.riverFed ?? false)) return null;
+      if (s < 0) {
+        inside++;
+      } else if (s < Math.max(step, 12)) {
+        if (h < rimLo) rimLo = h;
+        if (h > rimHi) rimHi = h;
+      }
+    }
+  }
+  if (inside < 3 || rimLo === Infinity) return null;
+  if (c.level !== undefined) {
+    // A river's lake: the rim may stand higher than usual (it lies in the
+    // hollow the river drained into) but must not fall away below the water.
+    if (rimLo < c.level - 1 || rimHi > c.level + (c.maxSpread ?? 20)) return null;
+    lake.level = c.level;
+  } else {
+    if (rimHi - rimLo > (c.maxSpread ?? 20)) return null;
+    lake.level = rimLo - (c.freeboard ?? 0.9);
+  }
+  if (lake.level - lake.depth < ctx.minBed) return null;
+  survey(lake, ctx.ground);
+  return lake;
+}
+
+/**
+ * How high the ground stands round a lake, bearing by bearing: the steepest
+ * elevation angle of anything within a few kilometres. A lake under a wall
+ * reflects the wall, not the sky above it.
+ */
+function survey(l: Lake, ground: (x: number, z: number) => number): void {
+  const cx = (l.minX + l.maxX) / 2;
+  const cz = (l.minZ + l.maxZ) / 2;
+  const reach = Math.max(l.maxX - l.minX, l.maxZ - l.minZ) / 2;
+  let lit = 0;
+  for (let k = 0; k < 8; k++) {
+    const a = (k / 8) * Math.PI * 2;
+    const dx = Math.sin(a);
+    const dz = -Math.cos(a);
+    // From the middle of the far side's water, roughly: the reflection seen
+    // across a lake is of the far bank and what rises behind it.
+    let best = 0;
+    for (let d = reach * 0.6 + 60; d < reach + 6000; d *= 1.18) {
+      const h = ground(cx + dx * d, cz + dz * d) - l.level;
+      const ang = Math.atan2(h, Math.max(1, d - reach * 0.3));
+      if (ang > best) best = ang;
+      if (d > reach + 600 && h > 1400) lit += 1;
+    }
+    l.skyline[k] = best;
+  }
+  // Snow and pale rock above the lake throw back more light than forest.
+  l.surround = clamp(0.25 + lit * 0.02, 0.25, 0.6);
+}
+
+/** Lay the grid over every lake's reach. */
+function reindex(): void {
+  grid = [];
+  gridW = 0;
+  gridH = 0;
+  if (lakes.length === 0) return;
+  let x0 = Infinity; let x1 = -Infinity; let z0 = Infinity; let z1 = -Infinity;
+  for (const l of lakes) {
+    const r = LAKE_REACH + l.wobble;
+    x0 = Math.min(x0, l.minX - r);
+    x1 = Math.max(x1, l.maxX + r);
+    z0 = Math.min(z0, l.minZ - r);
+    z1 = Math.max(z1, l.maxZ + r);
+  }
+  gridX0 = Math.floor(x0 / BUCKET) * BUCKET;
+  gridZ0 = Math.floor(z0 / BUCKET) * BUCKET;
+  gridW = Math.floor((x1 - gridX0) / BUCKET) + 1;
+  gridH = Math.floor((z1 - gridZ0) / BUCKET) + 1;
+  grid = new Array(gridW * gridH);
+  lakes.forEach((l, id) => {
+    const r = LAKE_REACH + l.wobble;
+    const gx0 = Math.floor((l.minX - r - gridX0) / BUCKET);
+    const gx1 = Math.floor((l.maxX + r - gridX0) / BUCKET);
+    const gz0 = Math.floor((l.minZ - r - gridZ0) / BUCKET);
+    const gz1 = Math.floor((l.maxZ + r - gridZ0) / BUCKET);
+    for (let gz = gz0; gz <= gz1; gz++) {
+      for (let gx = gx0; gx <= gx1; gx++) {
+        const k = gz * gridW + gx;
+        const b = grid[k];
+        if (b) b.push(id);
+        else grid[k] = [id];
+      }
+    }
+  });
+}
+
+// ----------------------------------------------------------------- proposals
+
+/** Deterministic [0,1) for the proposal helpers below. */
+export function lakeRandom(seed: number, i: number, salt: number): number {
+  return cellRandom(seed, i, 7700 + salt);
+}
+
+/**
+ * A lake of about `r` half-width at x, z, drawn out to `elong` times as long
+ * along bearing `angle` (radians). The shape most small lakes have.
+ */
+export function ovalLake(
+  kind: LakeKind, x: number, z: number, r: number, elong: number, angle: number,
+  extra: Partial<LakeCandidate> = {}, bend = 0,
+): LakeCandidate {
+  const half = r * Math.max(0, elong - 1);
+  const dx = Math.sin(angle) * half;
+  const dz = Math.cos(angle) * half;
+  // Bowed: the ends pulled one way across the axis, so a long lake curves.
+  const bx = Math.cos(angle) * r * bend;
+  const bz = -Math.sin(angle) * r * bend;
+  const pts: [number, number, number][] = half < 1
+    ? [[x, z, r]]
+    : [[x - dx + bx, z - dz + bz, r * 0.9], [x, z, r], [x + dx + bx, z + dz + bz, r * 0.8]];
+  return { kind, pts, ...extra };
+}
+
+/**
+ * Walk downhill from a point to the bottom of the hollow it lies in, in
+ * shrinking steps. Where a lake would collect.
+ */
+export function settle(
+  ground: (x: number, z: number) => number, x: number, z: number, reach: number,
+): { x: number; z: number; y: number } {
+  let cx = x;
+  let cz = z;
+  let cy = ground(x, z);
+  let step = reach * 0.4;
+  for (let i = 0; i < 10 && step > 8; i++) {
+    let moved = false;
+    for (let k = 0; k < 8; k++) {
+      const a = (k / 8) * Math.PI * 2;
+      const nx = cx + Math.sin(a) * step;
+      const nz = cz + Math.cos(a) * step;
+      if (Math.hypot(nx - x, nz - z) > reach) continue;
+      const h = ground(nx, nz);
+      if (h < cy) {
+        cy = h;
+        cx = nx;
+        cz = nz;
+        moved = true;
+      }
+    }
+    if (!moved) step *= 0.5;
+  }
+  return { x: cx, z: cz, y: cy };
+}
