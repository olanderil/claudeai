+  tarn: { deep: 0x0a2f3e, shallow: 0x2f6d6c, edge: 0x7f8580 },
+  alpine: { deep: 0x0b453a, shallow: 0x3c8f78, edge: 0x9ba38c },
+  karst: { deep: 0x1c342b, shallow: 0x475f43, edge: 0x6d5a3e },
+  mere: { deep: 0x15291f, shallow: 0x364e38, edge: 0x4c4632 },
+  flood: { deep: 0x22342a, shallow: 0x435239, edge: 0x565839 },
+  etang: { deep: 0x132a22, shallow: 0x35523a, edge: 0x4d4833 },
